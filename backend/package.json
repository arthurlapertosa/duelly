{
  "name": "@duelly/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/unit/*.test.ts test/integration/*.test.ts",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "qa": "npm run typecheck && npm run test",
    "db:migration:run": "tsx src/db/run-migrations.ts",
    "db:migration:show": "tsx src/db/show-migrations.ts",
    "db:migration:revert": "tsx src/db/revert-migration.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.49",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.30",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.2",
    "typeorm-ts-node-esm": "^0.3.20",
    "typescript": "^6.0.3"
  }
}

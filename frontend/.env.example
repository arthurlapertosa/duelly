# Duelly frontend environment
# Copy to .env for local development. .env is gitignored.

# API mode: "fixture" (in-memory mock, no backend) or "http" (real backend).
VITE_DUELLY_API_MODE=fixture

# Template data mode for http API reads: "fixture" or "live".
VITE_DUELLY_TEMPLATE_MODE=fixture

# Backend base URL, used when VITE_DUELLY_API_MODE=http.
VITE_API_BASE_URL=http://127.0.0.1:3000

# --- QA wallet (local/QA only — never enable in a production build) ---
# When VITE_QA_WALLET=true the app signs with the local private keys below
# instead of an injected browser wallet, so http mode can be driven end-to-end
# by Playwright. The keys are bundled into client JS, so keep this off by
# default and only use throwaway local-fork keys.
VITE_QA_WALLET=false
VITE_QA_MAKER_PRIVATE_KEY=
VITE_QA_TAKER_PRIVATE_KEY=
